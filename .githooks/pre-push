#!/bin/sh
# Bloqueia push direto para a main remota. Mudancas entram so por Pull Request.
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo ""
    echo "ERRO: push direto para a main bloqueado. Abra um Pull Request."
    echo ""
    exit 1
  fi
done
exit 0
